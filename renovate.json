{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitsDisabled"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "Europe/Berlin",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "labels": [
    "maintainability"
  ],
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on the first day of the month"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Rust dependencies (non-major)"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "JS dependencies (non-major)"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": [
        "rust-toolchain"
      ],
      "groupName": "Rust toolchain"
    },
    {
      "matchPackageNames": [
        "/^tauri/",
        "/^@tauri-apps//"
      ],
      "groupName": "Tauri"
    },
    {
      "description": "0.x minor bumps are breaking (Cargo and npm treat 0.y as major): own PR, after approval",
      "matchUpdateTypes": [
        "minor"
      ],
      "matchCurrentVersion": "/^[\\^~=]?0\\./",
      "groupName": null,
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": [
        "git2",
        "libgit2-sys"
      ],
      "groupName": "git2 / libgit2",
      "dependencyDashboardApproval": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
