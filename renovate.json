{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitsDisabled",
    "customManagers:githubActionsVersions"
  ],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Berlin",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "labels": ["maintainability"],
  "automerge": false,
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"]
  },
  "pip-compile": {
    "managerFilePatterns": ["/^docs/requirements\\.txt$/"]
  },
  "pip_requirements": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Rust dependencies (non-major)"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "JS dependencies (non-major)"
    },
    {
      "description": "pnpm's minimumReleaseAge (default 1 day) fails an install, --frozen-lockfile included, on a version published less than a day ago: propose none sooner (#361)",
      "matchManagers": ["npm"],
      "minimumReleaseAge": "1 day"
    },
    {
      "matchManagers": ["pip-compile"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Python docs tools (non-major)"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "GitHub Actions majors (actions, and the node/pnpm versions in setup steps): one PR per dependency, so each can be approved on its own",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": null
    },
    {
      "description": "The VSCode release CI's e2e-vscode and vsix-smoke jobs run in (ci.yml's BROWSITORY_E2E_VSCODE_VERSION, #918): wait for the first recovery release before proposing a new one",
      "matchPackageNames": ["microsoft/vscode"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "rust-toolchain.toml pins the one Rust version for local builds, CI and releases (#220): wait a week, so a release that gets a quick point fix (1.99.1) is skipped",
      "matchManagers": ["rust-toolchain"],
      "groupName": "Rust toolchain",
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": ["/^tauri/", "/^@tauri-apps//"],
      "groupName": "Tauri"
    },
    {
      "description": "tauri-action (release.yml, pinned by commit, #399) writes latest.json, the manifest every installed app's updater reads, and only runs on a release tag: its own PR, never grouped with the Tauri crates/packages (which /^tauri/ above would match) or other actions",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["tauri-apps/tauri-action"],
      "groupName": null
    },
    {
      "description": "0.x minor bumps are breaking (Cargo and npm treat 0.y as major): own PR, after approval",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "/^[\\^~=]?0\\./",
      "groupName": null,
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": ["git2", "libgit2-sys"],
      "groupName": "git2 / libgit2",
      "dependencyDashboardApproval": true
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
