{
  "name": "browsitory",
  "displayName": "Browsitory",
  "description": "A full Git client inside VSCode: commit graph, staging by hunk or line, branches, rebase, stashes, tags, worktrees and pull requests.",
  "version": "0.1.0",
  "publisher": "browsitory",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1b1a24",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rene-langer/browsitory",
    "directory": "extension"
  },
  "homepage": "https://github.com/rene-langer/browsitory#readme",
  "bugs": {
    "url": "https://github.com/rene-langer/browsitory/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "git client",
    "git graph",
    "commit graph",
    "history",
    "rebase",
    "staging",
    "branches",
    "stash",
    "worktree"
  ],
  "activationEvents": [
    "onCommand:browsitory.open"
  ],
  "main": "./dist/extension.js",
  "license": "MIT",
  "files": [
    "dist/**/*.js",
    "bin/**",
    "webview/**",
    "icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "browsitory.open",
        "title": "Browsitory: Open"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "lint": "tsc -p . --noEmit --pretty false",
    "test": "vitest --exclude 'scripts/**' --exclude 'e2e/**'",
    "test:package": "node --test scripts/package-vsix.staging.test.mjs scripts/check-vsix.test.mjs",
    "package:vsix": "node scripts/package-vsix.mjs",
    "check:vsix": "node scripts/check-vsix.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.134.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.28.10"
}
